# 🚀 ตัวอย่างค่า env — คัดลอกเป็น .env ด้วย scripts/new-env.ps1 (จะสุ่ม secret ให้)
# ⚠️ ห้ามใส่ค่าจริงในไฟล์นี้ และห้าม commit .env

# 💾 Database
POSTGRES_DB=webtestpdpa
POSTGRES_USER=webtestpdpa
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# ⚠️ Auth (JWT ใน httpOnly cookie)
JWT_SIGNING_KEY=CHANGE_ME_JWT_SIGNING_KEY
JWT_ISSUER=webtestpdpa
JWT_AUDIENCE=webtestpdpa-web
JWT_EXPIRES_MINUTES=60
# ⚠️ ตั้ง true เมื่อเปิดผ่าน HTTPS เท่านั้น
COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# 🚀 รหัสผ่านร่วมของ user พนักงาน emp001–emp020 (ข้อมูล mock R7) — ว่าง = ไม่สร้าง user พนักงาน; ถ้าตั้งต้องยาว >= 10 และผ่าน password policy
EMPLOYEE_SEED_PASSWORD=CHANGE_ME_EMPLOYEE_SEED_PASSWORD

# 💾 Vault (base64 ของ 32 bytes)
VAULT_ENCRYPTION_KEY=CHANGE_ME_VAULT_ENCRYPTION_KEY

# 📤 PII service (internal network เท่านั้น)
PII_SERVICE_TOKEN=CHANGE_ME_PII_SERVICE_TOKEN
# ⚠️ false = ปิด NER โดยตั้งใจ (หน้าแชทจะแสดง banner เตือน + audit บันทึก ner_enabled=false)
PII_NER_ENABLED=true
PII_TIMEOUT_SECONDS=5
PII_MAX_TEXT_LENGTH=5000

# 📤 LLM provider: mock | deepseek | openai | claude | ollama
# ⚠️ deepseek host อยู่ในจีน → ใช้กับข้อมูลทดสอบเท่านั้น
LLM_PROVIDER=mock
LLM_MODEL=
LLM_BASE_URL=
# ⚠️ ใส่ key ของคุณเองที่นี่ (เฉพาะใน .env) เมื่อใช้ deepseek/openai/claude
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.3
LLM_HISTORY_LIMIT=10

# 🧹 Retention / Rate limit
RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180
RETENTION_INTERVAL_MINUTES=60
RATE_LIMIT_PER_MINUTE=20

# 🚀 พอร์ตเว็บบน host
WEB_PORT=8080
